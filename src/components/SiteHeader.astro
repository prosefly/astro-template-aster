---
import { Icon } from '@prosefly/astro-components'
import { config } from '@/data/config'

const currentPath = Astro.url.pathname

function isCurrent(href: string): boolean {
  if (href === '/') return currentPath === href
  return currentPath.startsWith(href)
}
---

<header class="mx-auto flex min-h-20 w-[min(calc(100%-2rem),83rem)] items-center justify-between gap-4 sm:min-h-24 sm:w-[min(calc(100%-6rem),83rem)] sm:gap-8">
  <a
    class="inline-flex items-center gap-2 text-[0.95rem] font-[560] tracking-[-0.01em] focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-[5px] focus-visible:outline-ink"
    href="/"
  >
    <img
      class="size-[1.375rem] shrink-0"
      src="/images/aster-mark.svg"
      alt=""
      width="128"
      height="128"
    />
    <span>{config.site.name}</span>
  </a>

  <div class="flex items-center gap-3 sm:gap-8">
    <nav
      class="flex items-center gap-3 sm:gap-7"
      aria-label="Primary navigation"
    >
      {config.navigation.primary.map(({ href, label }) => (
        <a
          class="text-xs text-faint transition-colors duration-150 first:hidden hover:text-ink focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-[5px] focus-visible:outline-ink aria-[current=page]:text-ink motion-reduce:transition-none sm:text-sm sm:first:inline"
          href={href}
          aria-current={isCurrent(href) ? 'page' : undefined}
        >
          {label}
        </a>
      ))}
    </nav>

    <button
      class="relative grid size-7 cursor-pointer place-items-center border-0 bg-transparent p-0 text-faint transition-colors duration-150 hover:text-ink focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-[5px] focus-visible:outline-ink motion-reduce:transition-none"
      type="button"
      aria-label="Switch to light theme"
      data-theme-toggle
    >
      <Icon
        class="col-start-1 row-start-1 transition-[opacity,transform] duration-150 motion-reduce:transition-none light:-rotate-20 light:scale-[0.72] light:opacity-0"
        name="lucide:sun"
        size="17"
      />
      <Icon
        class="col-start-1 row-start-1 -rotate-20 scale-[0.72] opacity-0 transition-[opacity,transform] duration-150 motion-reduce:transition-none light:rotate-0 light:scale-100 light:opacity-100"
        name="lucide:moon"
        size="16"
      />
    </button>
  </div>
</header>
