---
import { Icon } from '@prosefly/astro-components'
import { config } from '@/data/config'

const currentPath = Astro.url.pathname

function isCurrent(href: string): boolean {
  return currentPath.startsWith(href)
}
---

<header class="page-shell flex min-h-20 flex-wrap items-center justify-between gap-4 py-4 sm:min-h-24 sm:gap-8">
  <a
    class="inline-flex min-h-11 items-center gap-2 text-base font-[560] tracking-[-0.01em] focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-[5px] focus-visible:outline-ink"
    href="/"
  >
    <img
      class="size-5.5 shrink-0"
      src="/images/aster-mark.svg"
      alt=""
      width="128"
      height="128"
    />
    <span>{config.site.name}</span>
  </a>

  <div class="flex items-center gap-2 sm:gap-6">
    <nav
      class="flex items-center gap-3 font-medium sm:gap-6"
      aria-label="Primary navigation"
    >
      {config.navigation.primary.map(({ href, label }) => (
        <a
          class="inline-flex min-h-11 items-center text-sm text-muted underline-offset-[0.2em] transition-colors duration-150 hover:text-ink hover:underline focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-[5px] focus-visible:outline-ink motion-reduce:transition-none sm:text-base"
          href={href}
          aria-current={isCurrent(href) ? 'page' : undefined}
        >
          {label}
        </a>
      ))}
    </nav>

    <button
      class="relative grid size-11 cursor-pointer place-items-center border-0 bg-transparent p-0 text-muted transition-colors duration-150 hover:text-ink focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-[5px] focus-visible:outline-ink motion-reduce:transition-none"
      type="button"
      aria-label="Switch to light theme"
      data-theme-toggle
    >
      <Icon
        class="col-start-1 row-start-1 transition-[opacity,transform] duration-150 motion-reduce:transition-none light:-rotate-20 light:scale-[0.72] light:opacity-0"
        name="lucide:sun"
        size="17"
      />
      <Icon
        class="col-start-1 row-start-1 -rotate-20 scale-[0.72] opacity-0 transition-[opacity,transform] duration-150 motion-reduce:transition-none light:rotate-0 light:scale-100 light:opacity-100"
        name="lucide:moon"
        size="16"
      />
    </button>
  </div>
</header>
