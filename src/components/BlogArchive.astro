---
import Pagination from '@/components/Pagination.astro'
import PageIntro from '@/components/PageIntro.astro'
import PostList from '@/components/PostList.astro'
import { config } from '@/data/config'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { BlogPost } from '@/lib/content'
import type { PaginationPage } from '@/lib/pagination'

interface Props {
  page: PaginationPage<BlogPost>
}

const { page } = Astro.props
const pageTitle =
  page.currentPage === 1
    ? `Blog — ${config.site.name}`
    : `Blog, page ${page.currentPage} — ${config.site.name}`

function getPageHref(pageNumber: number): string {
  return pageNumber === 1 ? '/blog/' : `/blog/page/${pageNumber}/`
}

const previousHref =
  page.currentPage > 1 ? getPageHref(page.currentPage - 1) : undefined
const nextHref =
  page.currentPage < page.totalPages
    ? getPageHref(page.currentPage + 1)
    : undefined
---

<BaseLayout
  title={pageTitle}
  description="Notes on building documentation themes, MDX components, and content infrastructure with Astro."
  previousUrl={previousHref}
  nextUrl={nextHref}
>
  <section class="page-shell pt-18 pb-20 min-[761px]:pt-16">
    <PageIntro
      eyebrow={`Writing · ${page.totalItems}`}
      title="Notes behind the"
      emphasis="projects."
      description="Architecture decisions, implementation details, and design principles from the Astro tools and themes featured in this Aster demo."
    />
  </section>

  <section class="page-shell pb-24" aria-label="Blog posts">
    <PostList posts={page.items} />
    <Pagination
      currentPage={page.currentPage}
      totalPages={page.totalPages}
      previousHref={previousHref}
      nextHref={nextHref}
    />
  </section>
</BaseLayout>
