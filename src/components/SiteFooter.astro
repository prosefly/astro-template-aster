---
import { config } from '@/data/config'

const year = new Date().getFullYear()
---

<footer class="flex w-full flex-col items-start justify-center gap-4 border-t border-rule/50 px-4 py-5 text-sm text-muted sm:flex-row sm:flex-wrap sm:items-center sm:justify-between sm:px-12 sm:py-4">
  <p class="m-0 inline-flex min-h-11 flex-wrap items-center gap-x-2">
    <span class="font-medium text-ink">{config.site.name}</span>
    <span>{config.footer.tagline}</span>
  </p>
  <nav
    class="flex max-w-full flex-wrap items-center gap-x-4 gap-y-1"
    aria-label="Footer navigation"
  >
    {config.navigation.footer.map(({ href, label }) => (
      <a
        class="inline-flex min-h-11 min-w-11 items-center whitespace-nowrap decoration-muted underline-offset-[0.2em] hover:text-ink hover:underline hover:decoration-ink focus:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
        href={href}
      >
        {label}
      </a>
    ))}
    <span>© {year}</span>
  </nav>
</footer>
