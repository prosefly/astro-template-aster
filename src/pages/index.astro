---
import PostList from '@/components/PostList.astro'
import ProjectList from '@/components/ProjectList.astro'
import { config } from '@/data/config'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getPublishedBlogPosts, getPublishedProjects } from '@/lib/content'

const [posts, projects] = await Promise.all([
  getPublishedBlogPosts(),
  getPublishedProjects(),
])
---

<BaseLayout>
  <section class="mx-auto w-[min(calc(100%-2rem),48.75rem)] pt-18 pb-20 min-[761px]:w-[min(calc(100%-3rem),48.75rem)] min-[761px]:pt-16">
    <h1 class="m-0 font-serif text-[clamp(2.5rem,4vw,2.75rem)] leading-[1.08] font-normal tracking-[-0.025em] [&_em]:font-normal [&_em]:text-muted">
      Projects and writing,
      <br />
      <em>built with Astro.</em>
    </h1>
    <p class="mt-8 max-w-2xl text-muted">
      Aster is a minimal portfolio and blog template for independent designers
      and developers. It pairs project case studies with long-form notes in a
      restrained editorial layout.
    </p>
    <p class="mt-4 max-w-2xl text-muted">
      Content stays in Astro collections and MDX. Explore the example projects,
      read the implementation notes, or{' '}
      <a
        class="underline decoration-faint underline-offset-[0.22em] transition-colors duration-150 hover:decoration-ink motion-reduce:transition-none"
        href={config.links.github}
      >
        browse the source
      </a>
      .
    </p>
  </section>

  <section
    class="mx-auto w-[min(calc(100%-2rem),48.75rem)] pb-12 min-[761px]:w-[min(calc(100%-3rem),48.75rem)]"
    aria-labelledby="selected-projects"
  >
    <h2
      class="m-0 text-[0.95rem] font-semibold tracking-[-0.01em]"
      id="selected-projects"
    >
      Selected projects
    </h2>
    <p class="mt-0.5 font-serif text-[clamp(1.4rem,2.5vw,1.6rem)] leading-[1.3] font-normal text-muted italic">
      Real tools, presented as complete case studies.
    </p>
    <p class="mt-3 mb-5 text-muted">
      This demo draws from the Prosefly ecosystem.
    </p>
    <ProjectList
      projects={projects.filter(({ data }) => data.featured).slice(0, 5)}
    />
  </section>

  <section
    class="mx-auto w-[min(calc(100%-2rem),48.75rem)] pb-24 min-[761px]:w-[min(calc(100%-3rem),48.75rem)]"
    aria-labelledby="latest-writing"
  >
    <h2
      class="m-0 text-[0.95rem] font-semibold tracking-[-0.01em]"
      id="latest-writing"
    >
      Writing
    </h2>
    <p class="mt-0.5 font-serif text-[clamp(1.4rem,2.5vw,1.6rem)] leading-[1.3] font-normal text-muted italic">
      Notes from the projects featured in Aster.
    </p>
    <p class="mt-3 mb-5 text-muted">
      Architecture decisions, implementation guides, and design principles.
    </p>
    <PostList posts={posts.slice(0, 5)} />
  </section>
</BaseLayout>
