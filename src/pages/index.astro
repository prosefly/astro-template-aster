---
import PostList from '@/components/PostList.astro'
import PageIntro from '@/components/PageIntro.astro'
import ProjectList from '@/components/ProjectList.astro'
import { config } from '@/data/config'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getPublishedBlogPosts, getPublishedProjects } from '@/lib/content'

const [posts, projects] = await Promise.all([
  getPublishedBlogPosts(),
  getPublishedProjects(),
])
---

<BaseLayout>
  <section class="page-shell pt-18 pb-20 min-[761px]:pt-16">
    <PageIntro title="Projects and writing," emphasis="built with Astro.">
      Aster is a minimal portfolio and blog template for independent designers
      and developers. It pairs project case studies with long-form notes in a
      restrained editorial layout. Content stays in Astro collections and MDX;
      explore the projects, read the implementation notes, or{' '}
      <a
        class="underline decoration-muted underline-offset-[0.22em] transition-colors duration-150 hover:decoration-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink motion-reduce:transition-none"
        href={config.links.github}
      >
        browse the source
      </a>
      .
    </PageIntro>
  </section>

  <section class="page-shell pb-16" aria-labelledby="selected-projects">
    <h2 class="section-title" id="selected-projects">
      Selected projects
    </h2>
    <p class="mt-2 text-muted">
      Real tools from the Prosefly ecosystem, presented as complete case
      studies.
    </p>
    <ProjectList
      projects={projects.filter(({ data }) => data.featured).slice(0, 5)}
    />
  </section>

  <section class="page-shell pb-24" aria-labelledby="latest-writing">
    <h2 class="section-title" id="latest-writing">
      Writing
    </h2>
    <p class="mt-2 text-muted">
      Architecture decisions, implementation guides, and design principles from
      the projects featured in Aster.
    </p>
    <PostList posts={posts.slice(0, 5)} />
  </section>
</BaseLayout>
