---
import PageIntro from '@/components/PageIntro.astro'
import { config } from '@/data/config'
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout
  title={`Page not found — ${config.site.name}`}
  description="The requested page could not be found."
>
  <section class="page-shell pt-18 pb-24 min-[761px]:pt-16">
    <PageIntro eyebrow="404" title="Nothing here," emphasis="for now.">
      The page may have moved or never existed.{' '}
      <a
        class="underline decoration-muted underline-offset-[0.22em] transition-colors duration-150 hover:decoration-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink motion-reduce:transition-none"
        href="/"
      >
        Return home
      </a>
      .
    </PageIntro>
  </section>
</BaseLayout>
