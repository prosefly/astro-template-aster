---
import PageIntro from '@/components/PageIntro.astro'
import { config } from '@/data/config'
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout
  title={`About — ${config.site.name}`}
  description="How Aster combines project case studies and long-form writing with Astro collections and MDX."
>
  <section class="page-shell pt-18 pb-20 min-[761px]:pt-16">
    <PageIntro
      eyebrow="About"
      title="A quiet frame,"
      emphasis="for independent work."
    >
      Aster is an Astro template for designers and developers who want projects
      and writing to share one focused home. Its restrained layout keeps the
      work legible without turning the site into a generic portfolio grid.
      Projects and posts remain ordinary content collections; Tailwind CSS owns
      the visual system, while Prosefly's Astro components provide reusable MDX
      structures without taking over the surrounding design.
    </PageIntro>
  </section>

  <section class="page-shell pb-24" aria-labelledby="contact-heading">
    <h2 class="section-title" id="contact-heading">
      Use Aster
    </h2>
    <p class="mt-2 text-muted">
      Source, setup instructions, and release history live on{' '}
      <a
        class="underline decoration-muted underline-offset-[0.22em] transition-colors duration-150 hover:decoration-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink motion-reduce:transition-none"
        href={config.links.github}
      >
        GitHub
      </a>
      .
    </p>
  </section>
</BaseLayout>
