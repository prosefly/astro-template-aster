---
import { config } from '@/data/config'
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout
  title={`About — ${config.site.name}`}
  description="How Aster combines project case studies and long-form writing with Astro collections and MDX."
>
  <section class="mx-auto w-[min(calc(100%-2rem),48.75rem)] pt-18 pb-20 min-[761px]:w-[min(calc(100%-3rem),48.75rem)] min-[761px]:pt-16">
    <p class="mb-3 font-mono text-[0.7rem] tracking-[0.08em] text-faint uppercase">
      About
    </p>
    <h1 class="m-0 font-serif text-[clamp(2.5rem,4vw,2.75rem)] leading-[1.08] font-normal tracking-[-0.025em] [&_em]:font-normal [&_em]:text-muted">
      A quiet frame,
      <br />
      <em>for independent work.</em>
    </h1>
    <p class="mt-8 max-w-2xl text-muted">
      Aster is an Astro template for designers and developers who want projects
      and writing to share one focused home. Its restrained layout keeps the
      work legible without turning the site into a generic portfolio grid.
    </p>
    <p class="mt-4 max-w-2xl text-muted">
      Projects and posts remain ordinary content collections. Tailwind CSS owns
      the visual system, while Prosefly's Astro components provide reusable MDX
      structures without taking over the surrounding design.
    </p>
  </section>

  <section
    class="mx-auto w-[min(calc(100%-2rem),48.75rem)] pb-24 min-[761px]:w-[min(calc(100%-3rem),48.75rem)]"
    aria-labelledby="contact-heading"
  >
    <h2
      class="m-0 text-[0.95rem] font-semibold tracking-[-0.01em]"
      id="contact-heading"
    >
      Use Aster
    </h2>
    <p class="mt-0.5 font-serif text-[clamp(1.4rem,2.5vw,1.6rem)] leading-[1.3] font-normal text-muted italic">
      Source, setup instructions, and release history live on GitHub.
    </p>
    <p class="mt-3 mb-5 text-muted">
      Browse{' '}
      <a
        class="underline decoration-faint underline-offset-[0.22em] transition-colors duration-150 hover:decoration-ink motion-reduce:transition-none"
        href={config.links.github}
      >
        github.com/prosefly/astro-template-aster
      </a>
      .
    </p>
  </section>
</BaseLayout>
