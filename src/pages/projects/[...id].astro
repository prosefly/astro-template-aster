---
import { render, type CollectionEntry } from 'astro:content'
import PostList from '@/components/PostList.astro'
import { config } from '@/data/config'
import ContentLayout from '@/layouts/ContentLayout.astro'
import {
  getPublishedBlogPosts,
  getPublishedProjects,
  type BlogPost,
} from '@/lib/content'

export async function getStaticPaths() {
  const [projects, posts] = await Promise.all([
    getPublishedProjects(),
    getPublishedBlogPosts(),
  ])

  return projects.map((project) => {
    const relatedPosts = posts.filter(
      ({ data }) => data.project?.id === project.id,
    )

    return {
      params: { id: project.id },
      props: {
        project,
        relatedPosts: relatedPosts.slice(
          0,
          config.content.projects.relatedPostsLimit,
        ),
        hasMoreRelatedPosts:
          relatedPosts.length > config.content.projects.relatedPostsLimit,
      },
    }
  })
}

interface Props {
  project: CollectionEntry<'projects'>
  relatedPosts: BlogPost[]
  hasMoreRelatedPosts: boolean
}

const { project, relatedPosts, hasMoreRelatedPosts } = Astro.props
const { Content } = await render(project)
const projectMeta = [
  String(project.data.year),
  project.data.status,
  ...project.data.tags,
]
---

<ContentLayout
  title={project.data.title}
  description={project.data.description}
  sectionHref="/projects/"
  sectionLabel="Projects"
  meta={projectMeta}
>
  <Content />

  <Fragment slot="after-content">
    {relatedPosts.length > 0 && (
      <section
        class="border-t border-rule pt-12"
        aria-labelledby="related-posts"
      >
        <h2
          class="m-0 text-[0.95rem] font-semibold tracking-[-0.01em]"
          id="related-posts"
        >
          Writing from {project.data.title}
        </h2>
        <p class="mt-0.5 font-serif text-[clamp(1.4rem,2.5vw,1.6rem)] leading-[1.3] font-normal text-muted italic">
          Decisions, implementation notes, and lessons from the work.
        </p>
        <PostList posts={relatedPosts} />
        {hasMoreRelatedPosts && (
          <a
            class="mt-5 inline-block text-sm text-muted underline decoration-faint underline-offset-[0.2em] transition-colors duration-150 hover:text-ink hover:decoration-ink focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-[5px] focus-visible:outline-ink motion-reduce:transition-none"
            href="/blog/"
          >
            View all writing →
          </a>
        )}
      </section>
    )}
  </Fragment>
</ContentLayout>
