---
import { render, type CollectionEntry } from 'astro:content'
import PostList from '@/components/PostList.astro'
import ContentLayout from '@/layouts/ContentLayout.astro'
import {
  getPublishedBlogPosts,
  getPublishedProjects,
  type BlogPost,
} from '@/lib/content'

export async function getStaticPaths() {
  const [projects, posts] = await Promise.all([
    getPublishedProjects(),
    getPublishedBlogPosts(),
  ])

  return projects.map((project) => ({
    params: { id: project.id },
    props: {
      project,
      relatedPosts: posts.filter(({ data }) => data.project?.id === project.id),
    },
  }))
}

interface Props {
  project: CollectionEntry<'projects'>
  relatedPosts: BlogPost[]
}

const { project, relatedPosts } = Astro.props
const { Content } = await render(project)
const projectMeta = [
  String(project.data.year),
  project.data.status,
  ...project.data.tags,
]
---

<ContentLayout
  title={project.data.title}
  description={project.data.description}
  sectionHref="/projects/"
  sectionLabel="Projects"
  meta={projectMeta}
>
  <Content />

  <Fragment slot="after-content">
    {relatedPosts.length > 0 && (
      <section
        class="border-t border-rule pt-12"
        aria-labelledby="related-posts"
      >
        <h2
          class="m-0 text-[0.95rem] font-semibold tracking-[-0.01em]"
          id="related-posts"
        >
          Writing from {project.data.title}
        </h2>
        <p class="mt-0.5 font-serif text-[clamp(1.4rem,2.5vw,1.6rem)] leading-[1.3] font-normal text-muted italic">
          Decisions, implementation notes, and lessons from the work.
        </p>
        <PostList posts={relatedPosts} />
      </section>
    )}
  </Fragment>
</ContentLayout>
