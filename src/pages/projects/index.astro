---
import ProjectList from '@/components/ProjectList.astro'
import { config } from '@/data/config'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getPublishedProjects } from '@/lib/content'

const projects = await getPublishedProjects()
---

<BaseLayout
  title={`Projects — ${config.site.name}`}
  description="Themes, components, and documentation infrastructure for Astro."
>
  <section class="mx-auto w-[min(calc(100%-2rem),48.75rem)] pt-18 pb-20 min-[761px]:w-[min(calc(100%-3rem),48.75rem)] min-[761px]:pt-16">
    <p class="mb-3 font-mono text-[0.7rem] tracking-[0.08em] text-faint uppercase">
      Projects · {projects.length}
    </p>
    <h1 class="m-0 font-serif text-[clamp(2.5rem,4vw,2.75rem)] leading-[1.08] font-normal tracking-[-0.025em] [&_em]:font-normal [&_em]:text-muted">
      Real projects,
      <br />
      <em>shown with Aster.</em>
    </h1>
    <p class="mt-8 max-w-2xl text-muted">
      Aster's demo collection features real Prosefly themes, components, and
      content infrastructure. Most are open source; Astro OpenAPI is distributed
      privately to sponsors.
    </p>
  </section>

  <section
    class="mx-auto w-[min(calc(100%-2rem),48.75rem)] pb-24 min-[761px]:w-[min(calc(100%-3rem),48.75rem)]"
    aria-label="All projects"
  >
    <ProjectList projects={projects} />
  </section>
</BaseLayout>
