---
import ProjectList from '@/components/ProjectList.astro'
import PageIntro from '@/components/PageIntro.astro'
import { config } from '@/data/config'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getPublishedProjects } from '@/lib/content'

const projects = await getPublishedProjects()
---

<BaseLayout
  title={`Projects — ${config.site.name}`}
  description="Themes, components, and documentation infrastructure for Astro."
>
  <section class="page-shell pt-18 pb-20 min-[761px]:pt-16">
    <PageIntro
      eyebrow={`Projects · ${projects.length}`}
      title="Real projects,"
      emphasis="shown with Aster."
      description="Aster's demo collection features real Prosefly themes, components, and content infrastructure. Most are open source; Astro OpenAPI is distributed privately to sponsors."
    />
  </section>

  <section class="page-shell pb-24" aria-label="All projects">
    <ProjectList projects={projects} />
  </section>
</BaseLayout>
